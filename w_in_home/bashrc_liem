# ===== WSL – Phong cách Liêm 2.0 =====
# Features:
# - Greeting thiền + hào quang mờ (chỉ in 1 lần / session)
# - Prompt: giờ | RAM | R version (khi ở project R) | path | git branch (vàng)
# -------------------------------------

# Chỉ chạy cho interactive shell
[[ $- != *i* ]] && return

# ---------- Colors (ANSI) ----------
# NOTE: Dùng '\[\e[...m\]' để bash tính đúng độ dài prompt, tránh hiện ký tự lạ [\]
C_RESET='\[\e[0m\]'
C_DIM='\[\e[2m\]'       # mờ
C_BOLD='\[\e[1m\]'
C_GREEN='\[\e[32m\]'
C_BLUE='\[\e[34m\]'
C_YELLOW='\[\e[33m\]'
C_WHITE='\[\e[37m\]'
C_GRAY='\[\e[90m\]'

# ---------- Greeting (once per session) ----------
if [[ -z "${LIEM_GREETING_SHOWN:-}" ]]; then
  clear
  printf "\n"
  printf "🌼 %bNam Mô A Di Đà Phật%b\n" "$C_BOLD" "$C_RESET"
  printf "%b✨ Hào quang vô lượng chiếu tâm%b\n" "$C_DIM" "$C_RESET"
  printf "%b--------------------------------%b\n\n" "$C_DIM" "$C_RESET"
  export LIEM_GREETING_SHOWN=1
fi

# ---------- Helpers ----------
_liem_git_branch() {
  # In ra branch nếu đang ở git repo, ngược lại rỗng
  git rev-parse --abbrev-ref HEAD 2>/dev/null
}

_liem_ram_mb() {
  # Used/Total (MB) từ /proc/meminfo
  # used = MemTotal - MemAvailable
  awk '
    $1=="MemTotal:"     {t=$2}
    $1=="MemAvailable:" {a=$2}
    END {
      if (t>0 && a>0) {
        used=(t-a)/1024
        total=t/1024
        printf "%.0f/%.0fMB", used, total
      }
    }' /proc/meminfo 2>/dev/null
}

_liem_in_r_project() {
  # Nhận diện project R theo dấu hiệu phổ biến: .Rproj / renv.lock / DESCRIPTION
  # Dò tối đa 6 cấp cha để nhẹ.
  local d="$PWD"
  local i=0
  while [[ "$d" != "/" && $i -lt 6 ]]; do
    if ls "$d"/*.Rproj >/dev/null 2>&1 || \
       [[ -f "$d/renv.lock" ]] || \
       [[ -f "$d/DESCRIPTION" ]]; then
      return 0
    fi
    d="$(dirname "$d")"
    i=$((i+1))
  done
  return 1
}

_liem_r_version_short() {
  command -v R >/dev/null 2>&1 || return 1
  # Ví dụ: "R 4.5.2"
  R --version 2>/dev/null | head -n 1 | awk '{print $1" "$3}'
}

# ---------- Prompt builder ----------
_liem_prompt() {
  local time_str ram_str branch rinfo rv

  time_str="$(date +'%H:%M:%S')"
  ram_str="$(_liem_ram_mb)"

  # Git branch (vàng) — chỉ hiện khi có repo git
  branch="$(_liem_git_branch)"
  if [[ -n "$branch" ]]; then
    branch=" ${C_YELLOW}(${branch})${C_RESET}"
  else
    branch=""
  fi

  # R version — chỉ hiện khi ở project R
  rinfo=""
  if _liem_in_r_project; then
    rv="$(_liem_r_version_short)"
    if [[ -n "$rv" ]]; then
      rinfo="${C_BLUE}[${rv}]${C_RESET} "
    fi
  fi

  # Prompt 2 dòng: status line + input line
  PS1="${C_DIM}${time_str}${C_RESET} ${C_DIM}${ram_str}${C_RESET} ${rinfo}${C_GREEN}\u${C_BLUE}@\h${C_RESET} ${C_WHITE}\w${C_RESET}${branch}\n❯ "
}

# Bash sẽ gọi trước mỗi prompt
PROMPT_COMMAND=_liem_prompt
